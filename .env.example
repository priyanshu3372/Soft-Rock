# ── Site ─────────────────────────────────────────────────────────────
# Production URL, with no trailing slash. Leave unset until the domain is known.
# While unset, pages are marked noindex and canonical/sitemap URLs use localhost.
NEXT_PUBLIC_SITE_URL=

# ── Booking form delivery (configure at least one for production) ────
# Option A: email via Resend (https://resend.com). Free tier available.
RESEND_API_KEY=
# Where enquiries are sent. Comma-separate multiple addresses.
BOOKING_TO_EMAIL=softrocklive@gmail.com
# Must be on a domain verified in Resend. Defaults to Resend's test sender,
# which can only deliver to your own Resend account email.
BOOKING_FROM_EMAIL=

# Option B: any webhook that accepts JSON POSTs
# (Zapier, Make, Slack incoming webhook, Formspree, Google Apps Script, ...).
BOOKING_WEBHOOK_URL=
